# ========================================
# Environment Variables Template
# Copy this to .env and fill in real values
# ========================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Database (Supabase or PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
SCHEDULER_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (for job queue)
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:password@redis:6379/0

# Application Settings
ENVIRONMENT=development
WORKER_MODE=false
DB_AUTO_CREATE_SCHEMA=false
JOB_QUEUE_ENABLED=true

# Authentication — Supabase Auth only (local email/password auth was
# removed from this project entirely). Full Supabase settings
# (SUPABASE_JWT_SECRET, SUPABASE_AUTO_PROVISION, SUPABASE_ALLOW_SELF_SERVICE_SIGNUP,
# SUPABASE_SERVICE_ROLE_KEY, ...) live in backend/.env.example — copy that
# file to backend/.env as well.
ENABLE_LEGACY_API_KEY=false

# Scanner Configuration
ALLOWED_TARGETS=127.0.0.1
ENFORCE_TARGET_SCOPE=true

# API Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Model
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend URLs (for CORS)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=your-api-key-here
