# MIRSAD example configuration — placeholders only; never commit real secrets.
ENVIRONMENT=development
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SCHEDULER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0
VITE_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=
GEMINI_HTTP_PROXY=
JOB_PAYLOAD_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_TENANT_CLAIM=app_metadata.tenant_id
SUPABASE_ROLE_CLAIM=app_metadata.role
SUPABASE_AUTO_PROVISION=false
SUPABASE_ALLOW_SELF_SERVICE_SIGNUP=false
SUPABASE_JWT_SECRET=YOUR_SERVER_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SERVICE_ROLE_KEY
SUPABASE_JWKS_TIMEOUT_SECONDS=15
DB_CONNECT_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=180
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SUPABASE_MAX_CONNECTIONS=60
EXPECTED_APP_PROCESSES=2
DB_POOL_RESERVE_CONNECTIONS=20
DB_AUTO_CREATE_SCHEMA=false
JOB_QUEUE_ENABLED=true
WORKER_MODE=false
ENFORCE_TARGET_SCOPE=true
WEB_SCAN_VERIFY_TLS=true
ALLOWED_TARGETS=127.0.0.1
MAX_CONCURRENT_ENGINES=5
MAX_CONCURRENT_ENGINES_PER_TARGET=2
EVASION_LEVEL=standard
EVASION_JITTER_MIN_S=0.05
EVASION_JITTER_MAX_S=0.35
EVASION_HTTP_PROXY=
ENABLE_NUCLEI=true
EXTERNAL_ENGINE_PARALLELISM=2
NUCLEI_BINARY_PATH=nuclei
ENABLE_ZAP=true
ENABLE_SQLMAP=true
SQLMAP_BINARY_PATH=sqlmap
ENABLE_GHAURI=true
GHAURI_BINARY_PATH=ghauri
ENABLE_FFUF=true
FFUF_BINARY_PATH=ffuf
ENABLE_TESTSSL=true
ENABLE_SUBFINDER=true
ENABLE_HTTPX_PROBE=true
ENABLE_TRIVY=true
ENABLE_SEMGREP=true
ENABLE_GITLEAKS=true
ENABLE_TRUFFLEHOG=true
ENABLE_SOURCE_INTELLIGENCE=true
ENABLE_SOURCE_MAP_ANALYSIS=true
ENABLE_PLAYWRIGHT=true
ENABLE_ADVANCED_SECURITY=true
EXTERNAL_DAST_TIMEOUT_SECONDS=7200
# Optional DefectDojo integration (disabled by default)
DEFECTDOJO_ENABLED=true
DEFECTDOJO_URL=http://defectdojo-nginx:8080
DEFECTDOJO_API_URL=http://defectdojo-nginx:8080
DEFECTDOJO_API_TOKEN=
DEFECTDOJO_TIMEOUT=20
DEFECTDOJO_VERIFY_TLS=true
DEFECTDOJO_PRODUCT_PREFIX=MIRSAD
DEFECTDOJO_ENGAGEMENT_MODE=per_scan
DEFECTDOJO_IMPORT_MODE=native
DEFECTDOJO_MAX_RETRIES=5

# DefectDojo is part of the default docker-compose.yml stack; no security-results profile is required.
DEFECTDOJO_LOCAL_DB_PASSWORD=
DEFECTDOJO_LOCAL_ADMIN_PASSWORD=
DEFECTDOJO_DJANGO_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
DEFECTDOJO_CREDENTIAL_AES_256_KEY=GENERATE_A_LONG_RANDOM_SECRET
DEFECTDOJO_PORT=8081
DEFECTDOJO_INITIALIZE=true
DEFECTDOJO_ADMIN_USER=admin
DEFECTDOJO_ADMIN_MAIL=admin@defectdojo.local
DEFECTDOJO_SITE_URL=http://localhost:8081

# Runtime DB topology: docker-compose.yml runs 1 backend + 1 worker;
# docker-compose.production.yml runs 4 backend workers + 1 worker by default.
TRIVY_DB_REQUIRED=false

# Default local/production-safe behavior: never block image startup/build on a registry DB download.
TRIVY_DB_BOOTSTRAP_RETRIES=0

VITE_ENABLE_LOCAL_FIRST=true
VITE_API_KEY=
LOCAL_PG_PASSWORD=change-me   # local Postgres container password (optional; has a dev default)
# Password of the worker-only DB role (bypasses RLS). Create the role first with
# supabase/provisioning/worker_role.sql, using the same password; URL-encode it here.
WORKER_PG_PASSWORD_URLENCODED=
