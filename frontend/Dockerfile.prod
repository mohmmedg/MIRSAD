FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN timeout 3600 npm ci && test -d node_modules && test -f node_modules/.package-lock.json
COPY . .
ARG VITE_API_BASE_URL=
ARG VITE_SUPABASE_URL
ARG SUPABASE_PUBLIC_KEY
ARG VITE_ENABLE_LOCAL_FIRST=true
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_ENABLE_LOCAL_FIRST=$VITE_ENABLE_LOCAL_FIRST
RUN VITE_SUPABASE_ANON_KEY="$SUPABASE_PUBLIC_KEY" npm run build

FROM nginx:1.29-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
