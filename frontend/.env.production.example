# Public browser configuration only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Leave empty in same-origin production deployment; nginx proxies /api/ to FastAPI.
VITE_API_BASE_URL=
# Do not set VITE_API_KEY in production when using Supabase Bearer auth.
VITE_API_KEY=
