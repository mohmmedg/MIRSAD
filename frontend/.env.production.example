# Public browser configuration only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Leave empty for the same-origin Vercel gateway. For direct FastAPI access,
# set an HTTPS API origin and allow your Vercel domain in backend CORS_ORIGINS.
VITE_API_BASE_URL=
# Do not set VITE_API_KEY in production when using Supabase Bearer auth.
VITE_API_KEY=

# Optional direct WebSocket endpoint. Required when the API is behind the
# Vercel HTTP gateway and real-time progress is desired; polling still works.
VITE_WS_BASE_URL=
# Vercel server-only variable (configure in Project Settings, not VITE_*):
# MIRSAD_BACKEND_URL=https://your-deployed-fastapi.example
