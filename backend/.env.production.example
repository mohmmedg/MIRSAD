ENVIRONMENT=production

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_TENANT_CLAIM=tenant_id
SUPABASE_ROLE_CLAIM=app_metadata.role
SUPABASE_AUTO_PROVISION=true

SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:5432/postgres
DB_AUTO_CREATE_SCHEMA=false
DB_CONNECT_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=180
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

SCHEDULER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:5432/postgres

REDIS_URL=redis://redis:6379/0
JOB_QUEUE_ENABLED=true
WORKER_MODE=false

ENFORCE_TARGET_SCOPE=true
ALLOWED_TARGETS=example.com

CORS_ORIGINS=http://localhost
TRUST_PROXY_HEADERS=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

ENABLE_LEGACY_API_KEY=false
API_KEY=
# Configure these from the provider pricing for the selected Gemini model before enabling a non-zero daily AI budget.
AI_INPUT_COST_PER_1M_USD=0
AI_OUTPUT_COST_PER_1M_USD=0
