# Reproducible backend test image for CI and local Docker runs.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nmap ca-certificates libcap2-bin \
    && setcap cap_net_raw,cap_net_admin+eip "$(command -v nmap)" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt

COPY app/ ./app/
COPY tests/ ./tests/
COPY pytest.ini ./pytest.ini

ENV PYTHONUNBUFFERED=1 \
    ENVIRONMENT=test \
    API_KEY=test-api-key \
    ENFORCE_TARGET_SCOPE=true \
    ALLOWED_TARGETS=example.com \
    GEMINI_API_KEY=

CMD ["pytest"]
