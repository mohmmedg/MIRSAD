ENVIRONMENT=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DATABASE_URL=postgresql+psycopg://YOUR_SUPABASE_DB_USER:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DB_AUTO_CREATE_SCHEMA=false
DB_CONNECT_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=180
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_TENANT_CLAIM=tenant_id
SUPABASE_ROLE_CLAIM=app_metadata.role
SUPABASE_AUTO_PROVISION=true
ENFORCE_TARGET_SCOPE=true
ALLOWED_TARGETS=example.com
GEMINI_API_KEY=REPLACE_WITH_SECRET
CORS_ORIGINS=https://app.example.com
JOB_QUEUE_ENABLED=true
TRUST_PROXY_HEADERS=false

# Server-only Supabase admin key. Never expose this to VITE_* or the browser.
SUPABASE_SERVICE_ROLE_KEY=
